# ==============================================================================
# 搜分名单查询工具 · 发布仓库忽略规则
# 原则：真实数据（姓名 / 学号 / 原始名单）与重资产一律不入库；
#       仓库只保留可复现的源码、校验脚本与文档。
# 注意：git 不支持行尾注释，注释一律单独成行，否则整行会被当成模式。
# ==============================================================================

# ---------- 真实数据：绝对不入库 ----------
# 真实加分名单语料（含姓名 / 学号）
target/
# 真实名单样本 PDF
.samples/
# 真实数据的运行截图
.screenshots/
# 历史交付物与旧版本基线
.archive/
.trae-html-share-packages/

# ---------- 内部资料：留在本机，不公开 ----------
# 规定原文与工作通知（校内文件，且 格式.jpg 含真实学号与姓名）
notice/
# 依赖内部规定 PDF 的提取脚本
.tools/notice_dump.py
# 一次性的设计与实施过程文档（结论已提炼进 .tools/README.md 与 CHANGELOG）
docs/specs/

# 维护文档（docs/maintainer/ 下的发版流程、实测报告、交接文档，以及 .github/release_notes_*.md）
# 自 v2.13 起随仓库提供：公开仓库是贡献者唯一的入口，且本机不再保留副本时这些知识会永久丢失。
# 真正排除的只有真实数据（见上）与依赖校内文件的脚本。

# ---------- 成品与实验重资产（走 Release / 不入库）----------
# 成品是构建输出，可随时重建，不入库
搜分名单查询工具.html
.tools/*.onnx
.tools/*.zip
.tools/*.xlsx
.tools/ort_bundle.js
.tools/ppu_engine_extracted.js
.tools/dict.txt
.tools/app_v23.js
.tools/corpus_text_all.txt
# 隐私门禁的真值缓存，内含真实姓名，禁止入库
.tools/pii_truth.json

# ---------- .tools 采用白名单：默认全忽略，只放行可复现的部分 ----------
# 好处：以后往 .tools/ 里丢进任何含真实数据的实验产物，都不会被误提交。
.tools/*
!.tools/README.md
!.tools/build_v24.py
!.tools/build.py
# 构建输入：模板 + 资产 + 源码
!.tools/src/
!.tools/assets/
!.tools/render_unit.js
!.tools/launcher_check.py
!.tools/publish_check.py
!.tools/syntax_check.py
!.tools/rebuild_share_zip.py
!.tools/ui_a11y.py
!.tools/ui_barsync.py
!.tools/ui_contrast.py
!.tools/ui_pii_check.py
!.tools/ui_pii_scan.py
!.tools/ui_shot.py
!.tools/ui_static_check.py
!.tools/ui_zipcheck.py
!.tools/shot_demo.py
!.tools/verify_share.py
!.tools/ui_progcheck.py
!.tools/prog_report.py
!.tools/ui_ocrcheck.py
!.tools/ui_cssom.py
!.tools/ui_nbsp_check.py
!.tools/extract_ppu.py
!.tools/extract_models.py
!.tools/extract_assets.py
!.tools/onnx_tool.py
!.tools/demo/

# ---------- 通用垃圾 ----------
__pycache__/
*.pyc
*.log
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
